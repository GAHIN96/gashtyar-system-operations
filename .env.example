# Application Base URL (Domain or Subdomain where your app will run)
# Example: https://ops.gashtyar.com or https://status.yourdomain.com
APP_BASE_URL=http://localhost:3000

# Optional: Remote Turso LibSQL Database (Recommended for production on Vercel)
# Sign up free at https://turso.tech -> create db -> grab URL and token
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: SMTP Email Notification Configuration
# Can also be configured directly via the Admin Settings UI inside the app!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Gashtyar IT Operations <it-ops@gashtyar.com>"
